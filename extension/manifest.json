{
  "manifest_version": 3,
  "name": "Job Search Command Center",
  "version": "2.0.0",
  "description": "Capture jobs from LinkedIn, Lever, Greenhouse and more. Track, export PDFs, find company pages, check connections.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.lever.co/*",
    "https://boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkday.com/*",
    "https://*.ashbyhq.com/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://*.greenhouse.io/jobs/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkday.com/*",
        "https://*.ashbyhq.com/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
