{
  "name": "job-search-command-center",
  "version": "3.5.0",
  "description": "Unified job search management system - dashboard, MCP server, and browser extension",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mcp": "node mcp-server/src/index.js",
    "extract": "node mcp-server/extract-jobs.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "phase:complete": "node scripts/phase-gate.js"
  },
  "author": "John Ra",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.4.0",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  }
}
